/* ═══════════════════════════════════════════════════════════════════
   AUTOSTOCK STUDIO - ENTERPRISE OBSIDIAN DARK & ELECTRIC NEON THEME
   ═══════════════════════════════════════════════════════════════════ */

/* ── 1. Global Reset & Typography ───────────────────────────────── */
QMainWindow, QWidget {
    background-color: #080b11;
    color: #f1f5f9;
    font-family: 'Segoe UI Variable Text', 'Segoe UI', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 13px;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
}

#mainArea {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #080b11, stop:0.45 #0d121c, stop:1 #101625);
}

#setupSidebar, #scenesSidebar, #studioSidebar {
    background-color: #0c1018;
    border-right: 1px solid #192233;
}

#maSidebar {
    background-color: #0c1018;
    border-left: 1px solid #192233;
}

/* ── 2. Glassmorphic Cards & Frame Containers ──────────────────── */
QFrame#card, QFrame#toolCard {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #121826, stop:1 #0c101a);
    border: 1px solid #1f2b3f;
    border-radius: 12px;
    padding: 14px;
}

QFrame#card:hover, QFrame#toolCard:hover {
    border-color: #364663;
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #151d2d, stop:1 #0e131d);
}

QGroupBox {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #111724, stop:1 #0b0f18);
    border: 1px solid #1f2b3f;
    border-radius: 12px;
    margin-top: 18px;
    padding: 14px;
    padding-top: 18px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 4px;
    background-color: #172133;
    color: #818cf8;
    border: 1px solid #2d3b55;
    border-radius: 6px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

QFrame#statBox {
    border-radius: 12px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

/* ── 3. Typography & Text Hierarchy ────────────────────────────── */
QLabel {
    color: #e2e8f0;
}

QLabel#appTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.5px;
}

QLabel#heroTitle {
    color: #f8fafc;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.2px;
    padding: 0 0 2px 0;
}

QLabel#sectionHeader {
    color: #818cf8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.1px;
    padding: 6px 0 2px 0;
    text-transform: uppercase;
}

QLabel#mutedText {
    color: #94a3b8;
    font-size: 12px;
    line-height: 1.4;
}

QLabel#fieldLabel {
    color: #cbd5e1;
    font-size: 11.5px;
    font-weight: 700;
}

QLabel#appVersion {
    color: #818cf8;
    font-size: 11px;
    font-weight: 700;
    background-color: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 10px;
    padding: 2px 10px;
}

QLabel#badgeSuccess {
    background-color: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#badgeWarning {
    background-color: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#badgeError {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#badgeInfo {
    background-color: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.5px;
}

QLabel#shortcutBadge {
    background-color: #131b2a;
    color: #818cf8;
    border: 1px solid #24334d;
    border-radius: 4px;
    padding: 1px 5px;
    font-family: 'Consolas', 'Cascadia Code', monospace;
    font-size: 10px;
    font-weight: 700;
}

QLabel#statValue {
    color: #ffffff;
    font-size: 20px;
    font-weight: 850;
    background: transparent;
}

QLabel#statTitle {
    color: rgba(255, 255, 255, 0.7);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.8px;
    background: transparent;
}

/* ── 4. Interactive Buttons ────────────────────────────────────── */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #161e2e, stop:1 #111724);
    color: #e2e8f0;
    border: 1px solid #243048;
    border-top: 1px solid #334364;
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 650;
    min-height: 30px;
    font-size: 12px;
    outline: none;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d273c, stop:1 #161f30);
    border-color: #4b628a;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #0d121c;
    border-color: #6366f1;
    padding-top: 8px;
    padding-bottom: 4px;
}

QPushButton:focus {
    border: 1px solid #6366f1;
}

QPushButton:disabled {
    background-color: #0b0f17;
    color: #475569;
    border-color: #161f30;
}

/* Secondary Button (Glass Outline) */
QPushButton#secondaryBtn {
    background-color: #121826;
    color: #cbd5e1;
    border: 1px solid #28374f;
    border-radius: 8px;
    font-weight: 650;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#secondaryBtn:hover {
    background-color: #1a2335;
    border-color: #38bdf8;
    color: #ffffff;
}

QPushButton#secondaryBtn:pressed {
    background-color: #0e1420;
    border-color: #0284c7;
    padding-top: 8px;
    padding-bottom: 4px;
}

/* Primary Studio CTA Button (Electric Indigo Gradient) */
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:0.5 #6366f1, stop:1 #8b5cf6);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    font-weight: 800;
    font-size: 12.5px;
    padding: 7px 18px;
    min-height: 32px;
}

QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4338ca, stop:0.5 #4f46e5, stop:1 #7c3aed);
    border-color: rgba(255, 255, 255, 0.55);
    color: #ffffff;
}

QPushButton#primaryBtn:pressed {
    background: #3730a3;
    padding-top: 9px;
    padding-bottom: 5px;
}

QPushButton#primaryBtn:disabled {
    background: #1b1f30;
    color: #64748b;
    border-color: #262c40;
}

/* Danger / Stop Button (Ruby Red Gradient) */
QPushButton#dangerBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #dc2626, stop:0.5 #ef4444, stop:1 #f87171);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    font-weight: 750;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#dangerBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b91c1c, stop:0.5 #dc2626, stop:1 #ef4444);
    border-color: rgba(255, 255, 255, 0.45);
}

QPushButton#dangerBtn:pressed {
    background: #991b1b;
    padding-top: 8px;
    padding-bottom: 4px;
}

QPushButton#dangerBtn:disabled {
    background: #1a1215;
    color: #55333a;
    border-color: #27171d;
}

/* Success / Download Button (Emerald Neon Gradient) */
QPushButton#successBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #059669, stop:0.5 #10b981, stop:1 #34d399);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-top: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 8px;
    font-weight: 800;
    padding: 6px 16px;
    min-height: 30px;
}

QPushButton#successBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #047857, stop:0.5 #059669, stop:1 #10b981);
    border-color: rgba(255, 255, 255, 0.5);
}

QPushButton#successBtn:pressed {
    background: #065f46;
    padding-top: 8px;
    padding-bottom: 4px;
}

QPushButton#successBtn:disabled {
    background: #121e1a;
    color: #4d7a6a;
    border-color: #1a2e26;
}

/* Warning / Alert Button (Amber / Gold Gradient) */
QPushButton#warningBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #d97706, stop:0.5 #f59e0b, stop:1 #fbbf24);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    font-weight: 750;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#warningBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #b45309, stop:0.5 #d97706, stop:1 #f59e0b);
    border-color: rgba(255, 255, 255, 0.45);
}

QPushButton#warningBtn:pressed {
    background: #92400e;
    padding-top: 8px;
    padding-bottom: 4px;
}

/* Accent Feature Button (Sky Cyan Gradient) */
QPushButton#accentBtn, QPushButton#purpleBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0284c7, stop:0.5 #0ea5e9, stop:1 #38bdf8);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-top: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 8px;
    font-weight: 750;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#accentBtn:hover, QPushButton#purpleBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0369a1, stop:0.5 #0284c7, stop:1 #0ea5e9);
    border-color: rgba(255, 255, 255, 0.5);
}

QPushButton#accentBtn:pressed, QPushButton#purpleBtn:pressed {
    background: #075985;
    padding-top: 8px;
    padding-bottom: 4px;
}

/* Active Segmented Filter Button */
QPushButton#filterActive {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:1 #6366f1);
    color: #ffffff;
    border: 1px solid #818cf8;
    border-radius: 8px;
    font-weight: 800;
    padding: 6px 14px;
    min-height: 30px;
}

QPushButton#filterActive:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4338ca, stop:1 #4f46e5);
}

/* Inactive Segmented Filter Button */
QPushButton#filterInactive {
    background-color: #101624;
    color: #94a3b8;
    border: 1px solid #1e293b;
    border-radius: 8px;
    font-weight: 650;
    padding: 6px 12px;
    min-height: 30px;
}

QPushButton#filterInactive:hover {
    background-color: #182236;
    color: #f8fafc;
    border-color: #38bdf8;
}

/* Square Tool / Icon Button */
QPushButton#toolBtn {
    min-width: 32px;
    max-width: 36px;
    min-height: 32px;
    max-height: 36px;
    padding: 4px;
    border-radius: 8px;
    background-color: #121826;
    border: 1px solid #243048;
}

QPushButton#toolBtn:hover {
    background-color: #1c263c;
    border-color: #38bdf8;
}

/* ── 5. Form Input Fields ───────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #090d15;
    color: #f8fafc;
    border: 1px solid #1f2b3f;
    border-radius: 8px;
    padding: 6px 12px;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    font-size: 12px;
    min-height: 20px;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover,
QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #364663;
    background-color: #0c111b;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #6366f1;
    background-color: #0f1524;
}

/* ComboBox Dropdown Styling */
QComboBox::drop-down {
    border: none;
    width: 24px;
    margin-right: 4px;
}

QComboBox QAbstractItemView {
    background-color: #0e1420;
    color: #f8fafc;
    border: 1px solid #27364d;
    border-radius: 8px;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    padding: 6px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 22px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #1a2335;
}

/* ── 6. Checkboxes & Radio Buttons ─────────────────────────────── */
QCheckBox {
    color: #e2e8f0;
    spacing: 8px;
    font-weight: 600;
    font-size: 12px;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1.5px solid #334155;
    border-radius: 5px;
    background-color: #090d15;
}

QCheckBox::indicator:hover {
    border-color: #818cf8;
    background-color: #0f1524;
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border-color: #a5b4fc;
}

/* ── 7. Studio Tabs (Pill Navigation) ──────────────────────────── */
QTabWidget::pane {
    border: 1px solid #1c2538;
    background-color: #0a0e16;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: #0b0f17;
    color: #8b949e;
    padding: 8px 18px;
    border: 1px solid #1c2538;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    margin-right: 3px;
    font-weight: 700;
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #141b29;
    color: #ffffff;
    border: 1px solid #6366f1;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: #0f1422;
    color: #e2e8f0;
    border-color: #2b3950;
}

/* ── 8. Lists & Tables ─────────────────────────────────────────── */
QTableWidget, QTreeWidget, QListWidget {
    background-color: #090d15;
    alternate-background-color: #0d121c;
    border: 1px solid #1f2b3f;
    border-radius: 10px;
    gridline-color: #1a2233;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
    padding: 4px;
}

QHeaderView::section {
    background-color: #111724;
    color: #94a3b8;
    border: none;
    border-right: 1px solid #1a2233;
    padding: 8px;
    font-weight: 800;
    font-size: 11px;
}

/* ── 9. Neon Progress Bars ─────────────────────────────────────── */
QProgressBar {
    background-color: #090d15;
    border: 1px solid #1f2b3f;
    border-radius: 6px;
    color: #f8fafc;
    text-align: center;
    min-height: 14px;
    font-weight: 700;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4f46e5, stop:0.5 #8b5cf6, stop:1 #06b6d4);
    border-radius: 5px;
}

/* ── 10. Ultra-Clean Minimalist Scrollbars ─────────────────────── */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background-color: transparent;
    margin: 0px;
}

QScrollBar:vertical { width: 7px; }
QScrollBar:horizontal { height: 7px; }

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background-color: #212c40;
    border-radius: 3px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background-color: #6366f1;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0px;
    height: 0px;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── 11. Status Bar & Tooltips ─────────────────────────────────── */
QStatusBar {
    background-color: #090d14;
    color: #94a3b8;
    border-top: 1px solid #171f2e;
    font-size: 11px;
    padding: 4px 12px;
}

QToolTip {
    background-color: #121826;
    color: #f8fafc;
    border: 1px solid #3b4d70;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── 12. Dialogs & Splitters ───────────────────────────────────── */
QMessageBox, QDialog {
    background-color: #0c1018;
}

QMessageBox QLabel, QDialog QLabel {
    color: #f1f5f9;
}

QSplitter::handle {
    background-color: #151d2b;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #6366f1;
}

/* Drag & Drop Visual Target Overlay */
#dragDropOverlay {
    background-color: rgba(8, 11, 17, 0.94);
    border: 2px dashed #6366f1;
    border-radius: 16px;
}
